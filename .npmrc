# Expo / React Native + pnpm.
# Los módulos nativos (op-sqlite, react-native-reanimated, expo-*) y la resolución
# de peers de @powersync esperan un node_modules plano. El node_modules simbólico y
# estricto de pnpm rompe el autolinking nativo y la resolución de peers entre paquetes
# del workspace (p. ej. @vaulto/shared importando @powersync/react-native).
# `hoisted` reproduce el layout que esperan Metro y el toolchain nativo.
node-linker=hoisted

# Evita advertencias de peers no satisfechos que en RN/Expo son esperadas.
strict-peer-dependencies=false
