# ===========================================================================
# Vaulto — variables de entorno (PLANTILLA)
# Copia este archivo a .env y completa con tus credenciales.
# NUNCA commitees el .env real. Los placeholders de aquí no son secretos.
# ===========================================================================

# --- Supabase (cliente / app Expo) ------------------------------------------
# Las variables expuestas a la app Expo deben llevar el prefijo EXPO_PUBLIC_.
# La URL y la anon key son públicas por diseño (la seguridad la da RLS).
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_publica

# --- PowerSync --------------------------------------------------------------
# Endpoint de la instancia de PowerSync conectada a tu Supabase.
EXPO_PUBLIC_POWERSYNC_URL=https://TU_INSTANCIA.powersync.journeyapps.com

# --- Cifrado local (SQLCipher) ----------------------------------------------
# La llave de SQLCipher NO se hardcodea ni se commitea. En producción se deriva
# por usuario y se guarda en el secure storage del dispositivo (expo-secure-store).
# Esta variable es solo para desarrollo local controlado.
SQLCIPHER_DEV_KEY=clave_solo_para_desarrollo_local

# --- Supabase (entorno local / CLI, NO va a la app) -------------------------
# Estos valores los imprime `supabase start` al levantar el entorno local.
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_SERVICE_ROLE_KEY=service_role_key_solo_para_scripts_de_servidor

# --- Servicios futuros (Render) — aún no existen ----------------------------
# RENDER_API_URL=
