# ===========================================================================
# Vaulto — variables de entorno (PLANTILLA)
# Copia este archivo a .env y completa con tus credenciales.
# NUNCA commitees el .env real.
# ===========================================================================

# --- Supabase (cliente / app Expo) ------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx

# --- PowerSync --------------------------------------------------------------
EXPO_PUBLIC_POWERSYNC_URL=https://TU_INSTANCIA.powersync.journeyapps.com

# --- Cifrado local ---------------------------------------------------------
# La app genera una llave aleatoria por usuario y la conserva en SecureStore.
# No configurar una llave SQLCipher global en variables de entorno.

# --- Supabase (server-only / scripts / CLI) ---------------------------------
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxx
SUPABASE_DB_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=TU_PASSWORD

# --- Servicios futuros ------------------------------------------------------
# RENDER_API_URL=