{
  "name": "vaulto",
  "version": "0.0.0",
  "private": true,
  "description": "Vaulto — finanzas personales offline-first para Colombia/LATAM",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "app:dev": "pnpm --filter @vaulto/app start",
    "app:prebuild": "pnpm --filter @vaulto/app prebuild",
    "app:android": "pnpm --filter @vaulto/app android",
    "app:ios": "pnpm --filter @vaulto/app ios",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "powersync:start": "docker compose -f supabase/powersync/docker-compose.yml up -d",
    "powersync:stop": "docker compose -f supabase/powersync/docker-compose.yml down",
    "db:migrate": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/shared/src/types/database.ts",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
