# ===========================================================================
# Vaulto · app (Expo) — variables de entorno (PLANTILLA)
# Copia este archivo a .env y completa con tus credenciales.
# Solo variables con prefijo EXPO_PUBLIC_ llegan al bundle del cliente.
# La seguridad la da RLS (Supabase) + SQLCipher (local), no el secreto de estas claves.
# ===========================================================================

# URL del proyecto Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Anon key pública de Supabase (pública por diseño; protegida por RLS).
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_publica

# Endpoint de la instancia de PowerSync conectada a tu Supabase.
EXPO_PUBLIC_POWERSYNC_URL=https://TU_INSTANCIA.powersync.journeyapps.com
