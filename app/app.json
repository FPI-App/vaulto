{
  "expo": {
    "name": "Vaulto",
    "slug": "vaulto",
    "scheme": "vaulto",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vaulto.app"
    },
    "android": {
      "package": "com.vaulto.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3d8033e9-e3bf-460f-b39f-cbf78156b8bd"
      }
    },
    "owner": "edav404s-team"
  }
}
