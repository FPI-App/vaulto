{
  "name": "@vaulto/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Código compartido entre la app y el backend de Vaulto: tipos del esquema, dominio puro (contrato de integración + dinero) y esquema PowerSync",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./domain": "./src/domain/index.ts",
    "./powersync": "./src/powersync/index.ts"
  },
  "scripts": {
    "lint": "echo \"(pendiente configurar linter)\" && exit 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@powersync/react-native": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@powersync/react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@powersync/react-native": "^2.3.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
